# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env. Share real values with teammates privately, not in chat or GitHub.

# Microsoft Entra ID (from issue #1) 
# Tenant (the organization) ID
ENTRA_TENANT_ID=
# Frontend single-page app registration (used by MSAL.js in the browser)
ENTRA_SPA_CLIENT_ID=
# Backend API app registration (used by FastAPI / MSAL Python)
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=
# The scope the frontend requests, e.g. api://<api-client-id>/access_as_user
ENTRA_API_SCOPE=
# Third app registration from issue #1 (e.g. device-code test client) - confirm with teammate
ENTRA_DEVICE_CLIENT_ID=
# Downstream API scope used in the On-Behalf-Of exchange
GRAPH_SCOPE=https://graph.microsoft.com/User.Read

#  Database (PostgreSQL + pgvector) 
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Format: postgresql://<user>:<password>@<host>:5432/<db>
# Inside the dev container the host is "db"
DATABASE_URL=

#  LLM provider 
# Free tier: synthetic/public data ONLY
GEMINI_API_KEY=

#  App 
APP_ENV=development
